# CloudServe Intelligent Support System - environment template
# Copy to .env and fill in a key. NEVER commit .env (it is in .gitignore).
#
#   cp .env.example .env
#
# The system needs ONE model provider key. Both have free tiers that are
# sufficient for this project; you do not need to pay for anything.

# ---------------------------------------------------------------------------
# Model provider - set PROVIDER to "groq" or "openrouter", then fill in the
# matching key below. Groq is the default because its free tier is faster,
# which helps the p95 latency target.
# ---------------------------------------------------------------------------
PROVIDER=groq

# Option A - Groq. Free key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Option B - OpenRouter. Free key from https://openrouter.ai/keys
# This is the provider named in the pack's Setup Guide. If you hold an
# OpenRouter key rather than a Groq one, set PROVIDER=openrouter above.
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------------------
# Storage. These paths are created at runtime and are gitignored.
# ---------------------------------------------------------------------------
CHROMA_PATH=./storage/chroma
DATABASE_URL=sqlite:///./storage/decisions.db
CACHE_PATH=./storage/cache

# ---------------------------------------------------------------------------
# Routing thresholds. Both are derived from the development set rather than
# guessed; see the design document, decision D4.
# ---------------------------------------------------------------------------
CONFIDENCE_THRESHOLD=0.85
RELEVANCE_FLOOR=0.40

# ---------------------------------------------------------------------------
# Kill switch. Set to 1 to force every ticket to escalate with no model call.
# Also triggered by the presence of a file at storage/KILL.
# ---------------------------------------------------------------------------
KILL_SWITCH=0

# ---------------------------------------------------------------------------
# Operational
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3
METRICS_PORT=8001
